@* Map topology selection + per-topology details (hub size + castles). *@
@using OldenEra.Generator.Models

<div class="oe-section">
    <div class="oe-section-header">Topology</div>
    <p class="oe-hint">How player and neutral zones are arranged on the map.</p>

    <InlineFieldError Result="Validation"
                      FieldKey="@ValidationFieldKeys.Topology"
                      MessageElementId="topology-msg" />
    @if (HasBlockerOnNeutralFromCityHold && OnFixSwitchToHub.HasDelegate)
    {
        <div class="oe-field-msg" role="alert">
            <span>City Hold also works if the layout is Hub &amp; Spoke (the hub doubles as the neutral hold city).</span>
            <button type="button" class="oe-field-fix" @onclick="HandleFixSwitchToHub">Switch to Hub layout</button>
        </div>
    }

    <div class="oe-topo-grid @TopoClass" role="radiogroup" aria-label="Topology"
         aria-describedby="@(HasBlocker(ValidationFieldKeys.Topology) ? "topology-msg" : null)">
        @foreach (var (topo, label, svg) in Tiles)
        {
            var isSelected = Settings.Topology == topo;
            <button type="button"
                    class="oe-topo-tile @(isSelected ? "selected" : "")"
                    role="radio"
                    aria-checked="@isSelected.ToString().ToLower()"
                    @ref="_topoTileRefs[topo]"
                    @onclick="() => Select(topo)">
                <span class="oe-topo-svg" aria-hidden="true">@svg</span>
                <span class="oe-topo-label">@label</span>
            </button>
        }
    </div>

    @if (Settings.Topology == MapTopology.HubAndSpoke)
    {
        <SliderRow Label="Hub zone size"
                   Min="0.25" Max="3" Step="0.05" IsInt="false" Suffix="x"
                   Value="Settings.ZoneCfg.HubZoneSize"
                   ValueChanged="@(v => { Settings.ZoneCfg.HubZoneSize = v; NotifyChanged(); })" />
        <SliderRow Label="Castles in hub"
                   Min="0" Max="4" Step="1"
                   Value="Settings.ZoneCfg.HubZoneCastles"
                   ValueChanged="@(v => { Settings.ZoneCfg.HubZoneCastles = (int)v; NotifyChanged(); })" />
    }
</div>

@code {
    [Parameter, EditorRequired] public GeneratorSettings Settings { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Latest validation result. T-303.</summary>
    [Parameter] public SettingsValidator.Result? Validation { get; set; }
    /// <summary>Mechanical fix: switches to Hub-and-Spoke (resolves "City Hold needs neutrals"). T-303.</summary>
    [Parameter] public EventCallback OnFixSwitchToHub { get; set; }

    private bool HasBlocker(string key) => Validation?.HasBlockerOn(key) ?? false;
    private bool HasWarning(string key) => Validation?.HasWarningOn(key) ?? false;
    private string TopoClass =>
        HasBlocker(ValidationFieldKeys.Topology) ? "has-error" :
        HasWarning(ValidationFieldKeys.Topology) ? "has-warning" : "";
    // The "City Hold needs a neutral or Hub" blocker anchors on neutral-count
    // (so the "Add a neutral zone" fix lives there), but switching to Hub is
    // the alternative remediation — surface it on the topology picker too.
    private bool HasBlockerOnNeutralFromCityHold =>
        Validation?.Issues.Any(i =>
            i.Severity == SettingsValidator.Severity.Blocker
            && i.FieldKey == ValidationFieldKeys.NeutralZoneCount
            && i.Code == ValidationIssueCodes.NeutralZoneCountForCityHold) ?? false;

    private async Task Select(MapTopology topo)
    {
        if (Settings.Topology == topo) return;
        Settings.Topology = topo;
        await OnChanged.InvokeAsync();
    }

    private Task NotifyChanged() => OnChanged.InvokeAsync();

    // T-303 follow-up: after the "Switch to Hub layout" fix, move focus to the
    // Hub tile so screen-reader users land on the now-selected control.
    private readonly Dictionary<MapTopology, ElementReference> _topoTileRefs = new();
    private bool _focusHubTileNextRender;

    private async Task HandleFixSwitchToHub()
    {
        await OnFixSwitchToHub.InvokeAsync();
        _focusHubTileNextRender = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusHubTileNextRender)
        {
            _focusHubTileNextRender = false;
            if (_topoTileRefs.TryGetValue(MapTopology.HubAndSpoke, out var tile))
            {
                try { await tile.FocusAsync(); } catch { /* element may have been removed */ }
            }
        }
    }

    private static readonly (MapTopology Topo, string Label, MarkupString Svg)[] Tiles =
    {
        (MapTopology.Default,     "Ring",        new MarkupString(RingSvg)),
        (MapTopology.HubAndSpoke, "Hub & Spoke", new MarkupString(HubSvg)),
        (MapTopology.Chain,       "Chain",       new MarkupString(ChainSvg)),
        (MapTopology.Random,      "Random",      new MarkupString(RandomSvg)),
        (MapTopology.Balanced,    "Balanced",    new MarkupString(BalancedSvg)),
    };

    private const string RingSvg =
        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64' width='48' height='48' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>"
        + "<circle cx='32' cy='12' r='4' fill='currentColor'/>"
        + "<circle cx='52' cy='32' r='4' fill='currentColor'/>"
        + "<circle cx='32' cy='52' r='4' fill='currentColor'/>"
        + "<circle cx='12' cy='32' r='4' fill='currentColor'/>"
        + "<path d='M32 16 Q52 16 52 32 Q52 52 32 52 Q12 52 12 32 Q12 12 32 12 Z'/>"
        + "</svg>";

    private const string HubSvg =
        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64' width='48' height='48' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>"
        + "<circle cx='32' cy='32' r='6' fill='currentColor'/>"
        + "<circle cx='32' cy='10' r='4' fill='currentColor'/>"
        + "<circle cx='54' cy='32' r='4' fill='currentColor'/>"
        + "<circle cx='32' cy='54' r='4' fill='currentColor'/>"
        + "<circle cx='10' cy='32' r='4' fill='currentColor'/>"
        + "<line x1='32' y1='14' x2='32' y2='26'/>"
        + "<line x1='50' y1='32' x2='38' y2='32'/>"
        + "<line x1='32' y1='50' x2='32' y2='38'/>"
        + "<line x1='14' y1='32' x2='26' y2='32'/>"
        + "</svg>";

    private const string ChainSvg =
        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64' width='48' height='48' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>"
        + "<circle cx='10' cy='32' r='4' fill='currentColor'/>"
        + "<circle cx='25' cy='32' r='4' fill='currentColor'/>"
        + "<circle cx='40' cy='32' r='4' fill='currentColor'/>"
        + "<circle cx='55' cy='32' r='4' fill='currentColor'/>"
        + "<line x1='14' y1='32' x2='21' y2='32'/>"
        + "<line x1='29' y1='32' x2='36' y2='32'/>"
        + "<line x1='44' y1='32' x2='51' y2='32'/>"
        + "</svg>";

    private const string RandomSvg =
        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64' width='48' height='48' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>"
        + "<circle cx='14' cy='18' r='4' fill='currentColor'/>"
        + "<circle cx='48' cy='14' r='4' fill='currentColor'/>"
        + "<circle cx='20' cy='50' r='4' fill='currentColor'/>"
        + "<circle cx='52' cy='46' r='4' fill='currentColor'/>"
        + "<line x1='17' y1='21' x2='49' y2='44'/>"
        + "<line x1='44' y1='17' x2='22' y2='47'/>"
        + "<line x1='14' y1='22' x2='20' y2='46'/>"
        + "</svg>";

    private const string BalancedSvg =
        "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64' width='48' height='48' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>"
        + "<circle cx='32' cy='32' r='4' fill='currentColor'/>"
        + "<circle cx='32' cy='32' r='12'/>"
        + "<circle cx='32' cy='32' r='22'/>"
        + "<circle cx='32' cy='10' r='3' fill='currentColor'/>"
        + "<circle cx='54' cy='32' r='3' fill='currentColor'/>"
        + "<circle cx='32' cy='54' r='3' fill='currentColor'/>"
        + "<circle cx='10' cy='32' r='3' fill='currentColor'/>"
        + "<circle cx='32' cy='20' r='3' fill='currentColor'/>"
        + "<circle cx='44' cy='32' r='3' fill='currentColor'/>"
        + "<circle cx='32' cy='44' r='3' fill='currentColor'/>"
        + "<circle cx='20' cy='32' r='3' fill='currentColor'/>"
        + "</svg>";
}
