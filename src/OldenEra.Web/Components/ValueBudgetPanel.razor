@* T-701 — Zone value budget summary.
   Pure read over a generated RmgTemplate: shows per-zone Resources / Guarded /
   Unguarded value (and per-area variants), plus a totals row. Hidden until
   generation has run. Numbers come straight off Zone.* fields with no
   recomputation. *@

@using OldenEra.Generator.Models.Unfrozen
@using OldenEra.Generator.Services

@if (Template is not null)
{
    var report = TemplateAnalysis.ComputeValueBudget(Template);
    if (report.HasData)
    {
        <details class="oe-value-budget" open>
            <summary class="oe-value-budget-summary">
                Zone value budget
                <span class="oe-value-budget-total" title="Sum of scalar values across all zones">
                    total @report.Totals.Combined.ToString("N0")
                </span>
            </summary>

            <div class="oe-value-budget-grid" role="table" aria-label="Per-zone value budget">
                <div class="oe-vb-head" role="row">
                    <div role="columnheader">Zone</div>
                    <div role="columnheader" title="Zone.resourcesValue / resourcesValuePerArea">Resources</div>
                    <div role="columnheader" title="Zone.guardedContentValue / guardedContentValuePerArea">Guarded</div>
                    <div role="columnheader" title="Zone.unguardedContentValue / unguardedContentValuePerArea">Unguarded</div>
                </div>

                @foreach (var z in report.Zones)
                {
                    <div class="oe-vb-row" role="row">
                        <div class="oe-vb-name" role="cell">@z.ZoneName</div>
                        <div role="cell">@FormatPair(z.ResourcesValue, z.ResourcesValuePerArea)</div>
                        <div role="cell">@FormatPair(z.GuardedContentValue, z.GuardedContentValuePerArea)</div>
                        <div role="cell">@FormatPair(z.UnguardedContentValue, z.UnguardedContentValuePerArea)</div>
                    </div>
                }

                <div class="oe-vb-row oe-vb-totals" role="row">
                    <div class="oe-vb-name" role="cell">Totals</div>
                    <div role="cell">@report.Totals.ResourcesValue.ToString("N0")</div>
                    <div role="cell">@report.Totals.GuardedContentValue.ToString("N0")</div>
                    <div role="cell">@report.Totals.UnguardedContentValue.ToString("N0")</div>
                </div>
            </div>
            <p class="oe-vb-hint">
                Per-area numbers in parentheses are densities — they are not summed
                in the totals row. Em-dash means the field is not emitted for that zone.
            </p>
        </details>
    }
}

@code {
    /// <summary>
    /// Last generated template, or <c>null</c> before any generation. Panel
    /// renders nothing while null — preserves the "hidden until generated"
    /// acceptance bullet.
    /// </summary>
    [Parameter] public RmgTemplate? Template { get; set; }

    private static string FormatPair(int? scalar, int? perArea)
    {
        string s = scalar?.ToString("N0") ?? "—";
        if (perArea is null) return s;
        return $"{s} ({perArea.Value:N0}/area)";
    }
}
