@* Renders the preview PNG (or a placeholder) plus a Reseed button.
   Wrapped in <details> so narrow viewports can collapse the preview and
   reach the action bar without scrolling past a tall image. Open by
   default; the summary is visually hidden on desktop via CSS. *@

<details class="oe-preview-details" open>
    <summary class="oe-preview-summary">Preview</summary>
    <div class="oe-preview-wrap">
        @if (PngBytes is { Length: > 0 } && OnReseed.HasDelegate)
        {
            <div class="oe-preview-toolbar">
                <button type="button" class="oe-link-btn oe-preview-reseed"
                        title="Pick a new random seed and regenerate"
                        disabled="@ReseedDisabled"
                        @onclick="HandleReseed">🎲 Reseed</button>
            </div>
        }
        <div class="oe-preview" @ref="_scrollEl">
            @if (PngBytes is { Length: > 0 })
            {
                <img src="@($"data:image/png;base64,{Convert.ToBase64String(PngBytes)}")"
                     alt="Map preview" />
            }
            else
            {
                <span class="placeholder">Preview will appear after Generate.</span>
            }
        </div>
    </div>
</details>

@code {
    [Parameter] public byte[]? PngBytes { get; set; }
    [Parameter] public EventCallback OnReseed { get; set; }
    [Parameter] public bool ReseedDisabled { get; set; }

    [Inject] private IJSRuntime Js { get; set; } = default!;

    private ElementReference _scrollEl;

    private async Task HandleReseed()
    {
        if (!OnReseed.HasDelegate || ReseedDisabled) return;
        // Snapshot scroll position so the user keeps their current view after
        // the regenerated PNG slots back into the same wrapper.
        var pos = await TryGetScrollPositionAsync();
        await OnReseed.InvokeAsync();
        if (pos is not null)
            await TrySetScrollPositionAsync(pos.Value.left, pos.Value.top);
    }

    private async Task<(double left, double top)?> TryGetScrollPositionAsync()
    {
        try
        {
            var arr = await Js.InvokeAsync<double[]>("oePreview.getScroll", _scrollEl);
            if (arr is { Length: >= 2 }) return (arr[0], arr[1]);
        }
        catch { }
        return null;
    }

    private async Task TrySetScrollPositionAsync(double left, double top)
    {
        try
        {
            await Js.InvokeVoidAsync("oePreview.setScroll", _scrollEl, left, top);
        }
        catch { }
    }
}
