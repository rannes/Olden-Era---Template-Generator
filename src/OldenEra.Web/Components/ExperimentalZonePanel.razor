@* Experimental zone-level capabilities, each in its own collapsible card. *@

<ExperimentalCard Key="terrain" Title="Terrain density">
    <div class="oe-hint">
        0% = generator default. Obstacles add chokepoints; lakes add water cover.
    </div>
    <SliderRow Label="Obstacles fill" WideLabel="true"
               Min="0" Max="80" Step="5" Suffix="%"
               Value="(int)Math.Round(Settings.Terrain.ObstaclesFill * 100)"
               ValueChanged="@(v => { Settings.Terrain.ObstaclesFill = v / 100.0; NotifyChanged(); })" />
    <SliderRow Label="Lakes fill" WideLabel="true"
               Min="0" Max="80" Step="5" Suffix="%"
               Value="(int)Math.Round(Settings.Terrain.LakesFill * 100)"
               ValueChanged="@(v => { Settings.Terrain.LakesFill = v / 100.0; NotifyChanged(); })" />
</ExperimentalCard>

<ExperimentalCard Key="building-presets" Title="Building presets">
    <div class="oe-hint">
        Force a specific build path. Default = let the generator pick.
    </div>
    <div class="oe-stacked">
        <label class="oe-label">Player-zone preset</label>
        <select @bind="Settings.BuildingPresets.PlayerZonePreset" @bind:after="NotifyChanged">
            <option value="">Default (generator picks)</option>
            @foreach (var sid in KnownValues.BuildingsConstructionSids)
            {
                <option value="@sid">@FriendlyPreset(sid)</option>
            }
        </select>
    </div>
    <div class="oe-stacked">
        <label class="oe-label">Neutral-zone preset</label>
        <select @bind="Settings.BuildingPresets.NeutralZonePreset" @bind:after="NotifyChanged">
            <option value="">Default (generator picks)</option>
            @foreach (var sid in KnownValues.BuildingsConstructionSids)
            {
                <option value="@sid">@FriendlyPreset(sid)</option>
            }
        </select>
    </div>
</ExperimentalCard>

<ExperimentalCard Key="guard-progression" Title="Guard progression">
    <div class="oe-hint">
        Weekly guard growth. 0 % = use the generator's defaults
        (15 % per zone, 15–20 % per connection).
    </div>
    <SliderRow Label="Zone guard / week" WideLabel="true"
               Min="0" Max="50" Step="1" Suffix="%"
               Value="(int)Math.Round(Settings.GuardProgression.ZoneGuardWeeklyIncrement * 100)"
               ValueChanged="@(v => { Settings.GuardProgression.ZoneGuardWeeklyIncrement = v / 100.0; NotifyChanged(); })" />
    <SliderRow Label="Connection guard / week" WideLabel="true"
               Min="0" Max="50" Step="1" Suffix="%"
               Value="(int)Math.Round(Settings.GuardProgression.ConnectionGuardWeeklyIncrement * 100)"
               ValueChanged="@(v => { Settings.GuardProgression.ConnectionGuardWeeklyIncrement = v / 100.0; NotifyChanged(); })" />
</ExperimentalCard>

<ExperimentalCard Key="guard-reaction" Title="Guard reaction curve">
    <div class="oe-hint">
        Per-zone <code>guardReactionDistribution</code>: 6 weekly weights (week 0..5)
        controlling how guard stacks spawn over time. Default = each zone keeps its
        baked-in shape (front-loaded for spawns, hub-heavy for the centre).
    </div>
    <div class="oe-stacked">
        <label class="oe-label">Preset</label>
        <select value="@Settings.GuardReaction.Preset.ToString()"
                @onchange="OnPresetChanged">
            <option value="@nameof(GuardReactionPreset.Default)">Default (per-zone baseline)</option>
            <option value="@nameof(GuardReactionPreset.FrontLoaded)">Front-loaded (60,20,10,10,2,0)</option>
            <option value="@nameof(GuardReactionPreset.Even)">Even (10,10,10,10,10,10)</option>
            <option value="@nameof(GuardReactionPreset.BackLoaded)">Back-loaded (0,2,10,20,30,40)</option>
            <option value="@nameof(GuardReactionPreset.Custom)">Custom…</option>
        </select>
    </div>
    @if (Settings.GuardReaction.Preset == GuardReactionPreset.Custom)
    {
        <div class="oe-stacked">
            <label class="oe-label">Custom distribution (6 ints, comma-separated)</label>
            <input type="text" value="@CustomCsv" @onchange="OnCustomCsvChanged"
                   placeholder="0, 10, 10, 10, 10, 0" />
            <div class="oe-hint">Length must be 6 and values non-negative, otherwise the default is used.</div>
        </div>
    }
</ExperimentalCard>

<ExperimentalCard Key="connection-defaults" Title="Connection defaults">
    <div class="oe-hint">
        Per-connection knobs the schema accepts. Each defaults to "unset" — leave alone
        and the generator's per-topology choices are preserved. Length is a relative
        path-distance multiplier (shipped templates use 0.0–5.0).
    </div>
    <SliderRow Label="Length" WideLabel="true"
               Min="0" Max="500" Step="5" Suffix="%"
               Value="(int)Math.Round(Settings.ConnectionDefaults.Length * 100)"
               ValueChanged="@(v => { Settings.ConnectionDefaults.Length = v / 100.0; NotifyChanged(); })" />
    <div class="oe-stacked">
        <label class="oe-label">Gate placement</label>
        <select @bind="Settings.ConnectionDefaults.GatePlacement" @bind:after="NotifyChanged">
            <option value="">Default (unset)</option>
            <option value="Center">Center</option>
        </select>
    </div>
    <div class="oe-stacked">
        <label class="oe-label">Guard escape</label>
        <select value="@TriBool(Settings.ConnectionDefaults.GuardEscape)"
                @onchange="@(e => { Settings.ConnectionDefaults.GuardEscape = ParseTriBool(e.Value?.ToString()); NotifyChanged(); })">
            <option value="">Default (unset)</option>
            <option value="false">false</option>
            <option value="true">true</option>
        </select>
    </div>
    <div class="oe-stacked">
        <label class="oe-label">Sim-turn squad</label>
        <select value="@TriBool(Settings.ConnectionDefaults.SimTurnSquad)"
                @onchange="@(e => { Settings.ConnectionDefaults.SimTurnSquad = ParseTriBool(e.Value?.ToString()); NotifyChanged(); })">
            <option value="">Default (unset)</option>
            <option value="false">false</option>
            <option value="true">true</option>
        </select>
    </div>
</ExperimentalCard>

<ExperimentalCard Key="neutral-cities" Title="Neutral cities">
    <div class="oe-hint">
        Chance that a neutral city gets a guarding stack, and how strong it is relative to the zone baseline (100%).
    </div>
    <SliderRow Label="Guard chance" WideLabel="true"
               Min="0" Max="100" Step="5" Suffix="%"
               Value="(int)Math.Round(Settings.NeutralCities.GuardChance * 100)"
               ValueChanged="@(v => { Settings.NeutralCities.GuardChance = v / 100.0; NotifyChanged(); })" />
    <SliderRow Label="Guard value" WideLabel="true"
               Min="25" Max="300" Step="5" Suffix="%"
               Value="Settings.NeutralCities.GuardValuePercent"
               ValueChanged="@(v => { Settings.NeutralCities.GuardValuePercent = (int)v; NotifyChanged(); })" />
    <label class="oe-checkbox" title="When set, neutral cities lose their guarding stack as soon as a player captures them.">
        <input type="checkbox"
               checked="@Settings.NeutralCities.RemoveGuardIfHasOwner"
               @onchange="@(e => { Settings.NeutralCities.RemoveGuardIfHasOwner = (bool)(e.Value ?? false); NotifyChanged(); })" />
        Drop guards on capture (removeGuardIfHasOwner)
    </label>
</ExperimentalCard>

<ExperimentalCard Key="content-control" Title="Content control">
    <div class="oe-hint">
        Ban specific objects, or cap how many of an object each player can have.
    </div>
    <UnitBanGrid Settings="Settings" OnChanged="OnChanged" />

    <div class="oe-stacked">
        <label class="oe-label">Per-player count limits</label>
        @foreach (var (limit, idx) in Settings.Content.ContentCountLimits.Select((l, i) => (l, i)))
        {
            <div class="oe-row" style="grid-template-columns: 1fr 80px 32px;">
                <select value="@limit.Sid" @onchange="@(e => OnLimitSidChanged(idx, e))">
                    <option value="">Pick object…</option>
                    @foreach (var sid in KnownValues.ObjectSids)
                    {
                        <option value="@sid">@sid</option>
                    }
                </select>
                <input type="number" min="0" max="20" step="1"
                       value="@limit.MaxPerPlayer"
                       @onchange="@(e => OnLimitMaxChanged(idx, e))" />
                <button type="button" class="oe-link-btn"
                        @onclick="@(() => RemoveLimit(idx))" aria-label="Remove">✕</button>
            </div>
        }
        <button type="button" class="oe-btn ghost" @onclick="AddLimit">+ Add count limit</button>
    </div>

    <div class="oe-stacked">
        <label class="oe-label">Value overrides (guard strength per SID)</label>
        <div class="oe-hint">
            Override the per-stack guard value for a specific object SID. Variant
            <code>-1</code> = any variant. Empty list emits nothing.
        </div>
        @foreach (var (vo, idx) in Settings.Content.ValueOverrides.Select((v, i) => (v, i)))
        {
            <div class="oe-row" style="grid-template-columns: 1fr 70px 100px 32px;">
                <select value="@vo.Sid" @onchange="@(e => OnVoSidChanged(idx, e))">
                    <option value="">Pick object…</option>
                    @foreach (var sid in KnownValues.ObjectSids)
                    {
                        <option value="@sid">@sid</option>
                    }
                </select>
                <input type="number" min="-1" step="1"
                       title="Variant (-1 = any)"
                       value="@vo.Variant"
                       @onchange="@(e => OnVoVariantChanged(idx, e))" />
                <input type="number" min="0" step="100"
                       title="Guard value"
                       value="@vo.GuardValue"
                       @onchange="@(e => OnVoGuardChanged(idx, e))" />
                <button type="button" class="oe-link-btn"
                        @onclick="@(() => RemoveValueOverride(idx))" aria-label="Remove">✕</button>
            </div>
        }
        <button type="button" class="oe-btn ghost" @onclick="AddValueOverride">+ Add value override</button>
    </div>
</ExperimentalCard>

<ExperimentalCard Key="zone-content" Title="Zone content">
    <div class="oe-hint">
        Author the zone-content surface (player zones, neutral tiers,
        per-zone overrides, road decorations).
    </div>
    <ZoneContentEditor Settings="Settings"
                       OnChanged="OnChanged"
                       CompareDefaultsOn="@ZoneContentCompareDefaults"
                       CompareDefaultsOnChanged="@ZoneContentCompareDefaultsChanged" />
</ExperimentalCard>

@code {
    [Parameter, EditorRequired] public GeneratorSettings Settings { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public bool ZoneContentCompareDefaults { get; set; }
    [Parameter] public EventCallback<bool> ZoneContentCompareDefaultsChanged { get; set; }

    private Task NotifyChanged() => OnChanged.InvokeAsync();

    private async Task AddLimit()
    {
        Settings.Content.ContentCountLimits.Add(new ContentLimit { Sid = "", MaxPerPlayer = 1 });
        await NotifyChanged();
    }

    private async Task RemoveLimit(int idx)
    {
        if (idx >= 0 && idx < Settings.Content.ContentCountLimits.Count)
            Settings.Content.ContentCountLimits.RemoveAt(idx);
        await NotifyChanged();
    }

    private async Task OnLimitSidChanged(int idx, ChangeEventArgs e)
    {
        Settings.Content.ContentCountLimits[idx].Sid = e.Value?.ToString() ?? "";
        await NotifyChanged();
    }

    private async Task OnLimitMaxChanged(int idx, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int v))
        {
            Settings.Content.ContentCountLimits[idx].MaxPerPlayer = Math.Max(0, v);
            await NotifyChanged();
        }
    }

    private async Task AddValueOverride()
    {
        // Default to variant=-1 (any) and guardValue=0 (which is treated as "unset"
        // and skipped on emit until the user types a real number).
        Settings.Content.ValueOverrides.Add(new ValueOverrideSetting { Sid = "", Variant = -1, GuardValue = 0 });
        await NotifyChanged();
    }

    private async Task RemoveValueOverride(int idx)
    {
        if (idx >= 0 && idx < Settings.Content.ValueOverrides.Count)
            Settings.Content.ValueOverrides.RemoveAt(idx);
        await NotifyChanged();
    }

    private async Task OnVoSidChanged(int idx, ChangeEventArgs e)
    {
        Settings.Content.ValueOverrides[idx].Sid = e.Value?.ToString() ?? "";
        await NotifyChanged();
    }

    private async Task OnVoVariantChanged(int idx, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int v))
        {
            Settings.Content.ValueOverrides[idx].Variant = v;
            await NotifyChanged();
        }
    }

    private async Task OnVoGuardChanged(int idx, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int v))
        {
            Settings.Content.ValueOverrides[idx].GuardValue = Math.Max(0, v);
            await NotifyChanged();
        }
    }

    private string CustomCsv =>
        Settings.GuardReaction.CustomDistribution is { Count: > 0 } cd
            ? string.Join(", ", cd)
            : "";

    private async Task OnPresetChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<GuardReactionPreset>(e.Value?.ToString(), ignoreCase: true, out var preset))
        {
            Settings.GuardReaction.Preset = preset;
            await NotifyChanged();
        }
    }

    private async Task OnCustomCsvChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        var parsed = new List<int>();
        bool ok = true;
        foreach (var token in raw.Split(',', StringSplitOptions.RemoveEmptyEntries))
        {
            if (int.TryParse(token.Trim(), out int v) && v >= 0) parsed.Add(v);
            else { ok = false; break; }
        }
        Settings.GuardReaction.CustomDistribution = ok ? parsed : new List<int>();
        await NotifyChanged();
    }

    private static string TriBool(bool? v) => v switch { true => "true", false => "false", _ => "" };

    private static bool? ParseTriBool(string? s) => s switch
    {
        "true" => true,
        "false" => false,
        _ => null,
    };

    private static string FriendlyPreset(string sid)
    {
        const string suffix = "_buildings_construction";
        return sid.EndsWith(suffix) ? sid[..^suffix.Length] : sid;
    }
}
