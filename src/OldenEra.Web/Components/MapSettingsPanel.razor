@* Template name, map size, experimental sizes toggle, player count. *@

@using OldenEra.Generator.Services

<div class="oe-section">
    <div class="oe-section-header">Template</div>

    <div class="oe-stacked">
        <label class="oe-label" for="tplname" title="@Help.For(ValidationFieldKeys.TemplateName)">Template Name</label>
        <div class="oe-field @TplNameClass">
            <input id="tplname" type="text"
                   @ref="_tplNameInput"
                   title="@Help.For(ValidationFieldKeys.TemplateName)"
                   value="@Settings.TemplateName"
                   aria-invalid="@(HasBlocker(ValidationFieldKeys.TemplateName) ? "true" : "false")"
                   aria-describedby="@(HasIssue(ValidationFieldKeys.TemplateName) ? "tplname-msg" : null)"
                   @oninput="OnTemplateNameInput" />
        </div>
        <InlineFieldError Result="Validation"
                          FieldKey="@ValidationFieldKeys.TemplateName"
                          MessageElementId="tplname-msg"
                          FixLabel="@(HasBlocker(ValidationFieldKeys.TemplateName) ? "Use \"Custom Template\"" : null)"
                          OnFix="HandleFixTemplateName" />
    </div>

    <div class="oe-stacked">
        <label class="oe-label" for="tpldescription">Description (optional)</label>
        <textarea id="tpldescription" rows="3"
                  value="@Settings.Description"
                  placeholder="Leave blank for auto-generated text"
                  @oninput="OnDescriptionInput"></textarea>
        <div class="oe-hint">
            Overrides the auto-generated <code>description</code> field. Empty
            falls back to the generator's summary (topology, zone counts, etc.).
        </div>
    </div>

    <div class="oe-stacked">
        <label class="oe-label" for="mapsize" title="@Help.For(ValidationFieldKeys.MapSize)">Map Size</label>
        <div class="oe-mapsize-row">
            <div class="oe-field @MapSizeClass">
                <select id="mapsize" @bind="MapSize" @bind:after="NotifyChanged"
                        title="@Help.For(ValidationFieldKeys.MapSize)"
                        aria-invalid="@(HasBlocker(ValidationFieldKeys.MapSize) ? "true" : "false")"
                        aria-describedby="@(HasIssue(ValidationFieldKeys.MapSize) ? "mapsize-msg" : null)">
                    @foreach (int size in AvailableMapSizes)
                    {
                        <option value="@size">@FormatMapSize(size)</option>
                    }
                </select>
            </div>
            <label class="oe-check inline">
                <input type="checkbox" checked="@ExperimentalMapSizes"
                       @onchange="OnExperimentalCheckboxChanged" />
                <span>Experimental large sizes</span>
                <ExperimentalBadge />
            </label>
        </div>
        @if (ExperimentalMapSizes)
        {
            <div class="oe-hint">
                Adds 256x256 through 512x512. Official templates top out at 240x240,
                so larger maps may fail, freeze, or behave unpredictably in game.
            </div>
        }
        <InlineFieldError Result="Validation"
                          FieldKey="@ValidationFieldKeys.MapSize"
                          MessageElementId="mapsize-msg" />
    </div>

    <div class="oe-stacked">
        <label class="oe-label" for="seed">Seed</label>
        <div class="oe-seed-row">
            <input id="seed" type="number"
                   title="Optional integer seed. Leave blank for non-deterministic generation."
                   value="@SeedText"
                   @oninput="OnSeedInput" />
            <button type="button"
                    class="oe-btn oe-seed-dice"
                    title="Generate a new random seed (reproducible output for the same seed)"
                    @onclick="RandomizeSeed">🎲</button>
        </div>
        <div class="oe-hint">
            Seeds the random choices this generator makes when building the
            template (zone topology, neutral placement, content rolls). The
            same seed with the same settings always produces an identical
            template file — useful for sharing or reproducing a template.
            Leave blank for a fresh template each time, or click 🎲 to pick a
            seed. Note: in-game map layout is rolled separately by Olden Era
            when a match starts, so the same template can still play
            differently.
        </div>
    </div>

    <div class="oe-field @PlayersClass">
        <SliderRow Label="Players"
                   Min="2" Max="8" Step="1"
                   Tooltip="@Help.For(ValidationFieldKeys.PlayerCount)"
                   Value="Settings.PlayerCount"
                   ValueChanged="@(v => { Settings.PlayerCount = (int)v; OnChanged.InvokeAsync(); })" />
    </div>
    <InlineFieldError Result="Validation"
                      FieldKey="@ValidationFieldKeys.PlayerCount"
                      MessageElementId="players-msg" />
</div>

@code {
    [Parameter, EditorRequired] public GeneratorSettings Settings { get; set; } = default!;
    [Parameter] public bool ExperimentalMapSizes { get; set; }
    [Parameter] public EventCallback<bool> ExperimentalMapSizesChanged { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Latest validation result. Drives inline error/warning anchors. T-303.</summary>
    [Parameter] public SettingsValidator.Result? Validation { get; set; }
    /// <summary>Mechanical fix: blank template name → seed default. T-303.</summary>
    [Parameter] public EventCallback OnFixTemplateName { get; set; }

    private bool HasBlocker(string key) => Validation?.HasBlockerOn(key) ?? false;
    private bool HasWarning(string key) => Validation?.HasWarningOn(key) ?? false;
    private bool HasIssue(string key) => HasBlocker(key) || HasWarning(key);
    private string FieldClass(string key) =>
        HasBlocker(key) ? "has-error" : HasWarning(key) ? "has-warning" : "";
    private string TplNameClass => FieldClass(ValidationFieldKeys.TemplateName);
    private string MapSizeClass => FieldClass(ValidationFieldKeys.MapSize);
    private string PlayersClass => FieldClass(ValidationFieldKeys.PlayerCount);

    private int MapSize
    {
        get => Settings.MapSize;
        set => Settings.MapSize = value;
    }

    private IEnumerable<int> AvailableMapSizes =>
        ExperimentalMapSizes ? KnownValues.AllMapSizes : KnownValues.MapSizes;

    private static string FormatMapSize(int size) =>
        KnownValues.IsExperimentalMapSize(size)
            ? $"{size}x{size} ({KnownValues.MapSizeLabel(size)}) (Experimental)"
            : $"{size}x{size} ({KnownValues.MapSizeLabel(size)})";

    private async Task OnTemplateNameInput(ChangeEventArgs e)
    {
        Settings.TemplateName = e.Value?.ToString() ?? "";
        await OnChanged.InvokeAsync();
    }

    private async Task OnDescriptionInput(ChangeEventArgs e)
    {
        Settings.Description = e.Value?.ToString() ?? "";
        await OnChanged.InvokeAsync();
    }

    private string SeedText => Settings.Seed?.ToString() ?? "";

    private async Task OnSeedInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        Settings.Seed = int.TryParse(raw, out var v) ? v : (int?)null;
        await OnChanged.InvokeAsync();
    }

    private async Task RandomizeSeed()
    {
        Settings.Seed = Random.Shared.Next(0, int.MaxValue);
        await OnChanged.InvokeAsync();
    }

    private async Task OnExperimentalCheckboxChanged(ChangeEventArgs e)
    {
        bool value = (bool)e.Value!;
        await ExperimentalMapSizesChanged.InvokeAsync(value);
        await OnChanged.InvokeAsync();
    }

    private Task NotifyChanged() => OnChanged.InvokeAsync();

    // T-803: shared field-help catalog for inline tooltips.
    private static readonly FieldHelpCatalog Help = FieldHelpCatalog.Default;

    // T-303 follow-up: after a one-click fix, move focus back to the now-fixed
    // control so screen-reader users aren't dropped on <body>.
    private ElementReference _tplNameInput;
    private bool _focusTplNameNextRender;

    private async Task HandleFixTemplateName()
    {
        await OnFixTemplateName.InvokeAsync();
        _focusTplNameNextRender = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusTplNameNextRender)
        {
            _focusTplNameNextRender = false;
            try { await _tplNameInput.FocusAsync(); } catch { /* element may have been removed */ }
        }
    }
}
