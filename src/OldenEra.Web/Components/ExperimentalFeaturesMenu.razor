@* T-302 — header dropdown that lists every experimental feature flag with a
   per-feature checkbox and a graduated/experimental badge. Replaces the old
   single "Experimental" master toggle. *@

@using OldenEra.Generator.Services

<div class="oe-exp-menu" @onclick:stopPropagation>
    <button type="button"
            class="oe-btn ghost oe-exp-menu-trigger"
            @onclick="Toggle"
            aria-expanded="@(IsOpen ? "true" : "false")"
            title="Per-feature experimental toggles.">
        <span>Experimental</span>
        @if (Flags.AnyEnabled)
        {
            <span class="oe-exp-menu-count">@CountEnabled</span>
        }
        <ExperimentalBadge />
        <span aria-hidden="true">@(IsOpen ? "▴" : "▾")</span>
    </button>

    @if (IsOpen)
    {
        <div class="oe-exp-menu-popover" role="menu">
            <div class="oe-exp-menu-header">
                Experimental features
            </div>
            <div class="oe-hint" style="padding:0 12px 8px;">
                Each flag enables one section card. Disabled cards stay hidden
                from the nav; their settings remain intact in memory.
            </div>
            @foreach (var feature in ExperimentalFeatures.All)
            {
                bool isOn = Flags.Get(feature.Key);
                <label class="oe-exp-menu-row">
                    <input type="checkbox"
                           checked="@isOn"
                           @onchange="@(e => OnToggle(feature.Key, (bool)e.Value!))" />
                    <div class="oe-exp-menu-row-label">
                        <div class="oe-exp-menu-row-title">
                            <span>@feature.Title</span>
                            @if (feature.Status == ExperimentalStatus.Graduated)
                            {
                                <span class="oe-graduated-badge"
                                      title="Graduated — feature is stable; toggle remains for backwards compat.">
                                    GRADUATED
                                </span>
                            }
                            else
                            {
                                <ExperimentalBadge />
                            }
                        </div>
                        <div class="oe-exp-menu-row-desc">@feature.Description</div>
                    </div>
                </label>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ExperimentalFlags Flags { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool IsOpen;

    private int CountEnabled => ExperimentalFeatures.All.Count(f => Flags.Get(f.Key));

    private void Toggle() => IsOpen = !IsOpen;

    private async Task OnToggle(string key, bool value)
    {
        Flags.Set(key, value);
        await OnChanged.InvokeAsync();
    }
}
