@* T-805 — Side-by-side field-level diff between the last-loaded preset and
   the current settings. Hidden when no preset has been loaded in this
   session (PresetSnapshot is null). Top-level scalar fields only — see
   SettingsDiff.Compute for the scope rationale. *@
@using OldenEra.Generator.Models
@using OldenEra.Generator.Services

@if (PresetSnapshot is not null && Current is not null)
{
    var rows = SettingsDiff.Compute(PresetSnapshot, Current);

    <div class="oe-card oe-preset-diff" role="region" aria-label="Preset diff">
        <div class="oe-card-header">
            <h3>Compared to preset: <code>@PresetName</code></h3>
            <span class="oe-preset-diff-count">@rows.Count changed</span>
        </div>

        @if (rows.Count == 0)
        {
            <p class="oe-preset-diff-empty">
                No top-level fields differ from the loaded preset.
            </p>
        }
        else
        {
            <table class="oe-preset-diff-table">
                <thead>
                    <tr>
                        <th scope="col">Field</th>
                        <th scope="col">Preset</th>
                        <th scope="col">Current</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        <tr>
                            <th scope="row"><code>@row.FieldPath</code></th>
                            <td class="oe-preset-diff-preset">@row.PresetValue</td>
                            <td class="oe-preset-diff-current">@row.CurrentValue</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    /// <summary>
    /// SettingsFile snapshot of the last preset loaded in this session.
    /// Null = no preset loaded yet → panel is hidden (T-805 hard rule).
    /// </summary>
    [Parameter] public SettingsFile? PresetSnapshot { get; set; }

    /// <summary>Display name of the loaded preset for the header.</summary>
    [Parameter] public string PresetName { get; set; } = "";

    /// <summary>Live SettingsFile representation of the current UI state.</summary>
    [Parameter] public SettingsFile? Current { get; set; }
}
