@* T-702 — Guard-power vs. zone-value chart.
   Pure read over a generated RmgTemplate: plots Zone.GuardMultiplier (X) vs
   Zone.ResourcesValue (Y) per zone, flagging the rich-and-weak corner in red.
   Hidden until generation has run. Inline SVG — no chart library. *@

@using OldenEra.Generator.Models.Unfrozen
@using OldenEra.Generator.Services
@using System.Globalization

@if (Template is not null)
{
    var report = TemplateAnalysis.ComputeGuardChart(Template);
    if (report.HasData)
    {
        // SVG viewport. Chart inner box leaves room for axis labels.
        const int W = 360;
        const int H = 220;
        const int PadL = 40;
        const int PadR = 12;
        const int PadT = 10;
        const int PadB = 28;
        double innerW = W - PadL - PadR;
        double innerH = H - PadT - PadB;

        // Pad the data range a touch so end points don't sit on the axis.
        double gMin = report.GuardMultiplierMin;
        double gMax = report.GuardMultiplierMax;
        if (gMax - gMin < 1e-6) { gMin -= 0.5; gMax += 0.5; }
        int vMin = report.ResourcesValueMin;
        int vMax = report.ResourcesValueMax;
        if (vMax == vMin) { vMin = System.Math.Max(0, vMin - 1); vMax += 1; }

        double Sx(double g) => PadL + (g - gMin) / (gMax - gMin) * innerW;
        double Sy(double v) => PadT + innerH - (v - vMin) / (double)(vMax - vMin) * innerH;

        <details class="oe-guard-chart" open>
            <summary class="oe-gc-summary">
                Guard vs. value
                <span class="oe-gc-outliers" title="Zones flagged as rich with weak guards">
                    @if (report.OutlierCount > 0)
                    {
                        <text>@report.OutlierCount outlier@(report.OutlierCount == 1 ? "" : "s")</text>
                    }
                    else
                    {
                        <text>no outliers</text>
                    }
                </span>
            </summary>

            <svg class="oe-gc-svg" viewBox="0 0 @W @H" role="img"
                 aria-label="Guard multiplier versus resources value, per zone">
                <!-- Plot frame -->
                <rect x="@PadL.ToString(CultureInfo.InvariantCulture)"
                      y="@PadT.ToString(CultureInfo.InvariantCulture)"
                      width="@innerW.ToString("F1", CultureInfo.InvariantCulture)"
                      height="@innerH.ToString("F1", CultureInfo.InvariantCulture)"
                      class="oe-gc-frame"/>

                <!-- Y axis label (resources value) -->
                <text x="6" y="@(PadT + 4).ToString(CultureInfo.InvariantCulture)"
                      class="oe-gc-axis-tick">@vMax</text>
                <text x="6" y="@(PadT + innerH).ToString("F1", CultureInfo.InvariantCulture)"
                      class="oe-gc-axis-tick">@vMin</text>
                <text x="@(PadL).ToString(CultureInfo.InvariantCulture)"
                      y="@(H - 4).ToString(CultureInfo.InvariantCulture)"
                      class="oe-gc-axis-label">guard mult.</text>

                <!-- X axis ticks (min, max) -->
                <text x="@PadL.ToString(CultureInfo.InvariantCulture)"
                      y="@(H - 14).ToString(CultureInfo.InvariantCulture)"
                      class="oe-gc-axis-tick">@gMin.ToString("F2", CultureInfo.InvariantCulture)</text>
                <text x="@(PadL + innerW).ToString("F1", CultureInfo.InvariantCulture)"
                      y="@(H - 14).ToString(CultureInfo.InvariantCulture)"
                      class="oe-gc-axis-tick" text-anchor="end">@gMax.ToString("F2", CultureInfo.InvariantCulture)</text>

                <!-- Points: outliers last so they sit on top -->
                @foreach (var p in report.Points.Where(p => !p.IsOutlier))
                {
                    <circle cx="@Sx(p.GuardMultiplier).ToString("F1", CultureInfo.InvariantCulture)"
                            cy="@Sy(p.ResourcesValue).ToString("F1", CultureInfo.InvariantCulture)"
                            r="4" class="oe-gc-point">
                        <title>@p.ZoneName: guard @p.GuardMultiplier.ToString("F2", CultureInfo.InvariantCulture), value @p.ResourcesValue.ToString("N0", CultureInfo.InvariantCulture)</title>
                    </circle>
                }
                @foreach (var p in report.Points.Where(p => p.IsOutlier))
                {
                    <circle cx="@Sx(p.GuardMultiplier).ToString("F1", CultureInfo.InvariantCulture)"
                            cy="@Sy(p.ResourcesValue).ToString("F1", CultureInfo.InvariantCulture)"
                            r="5" class="oe-gc-point oe-gc-point-outlier">
                        <title>OUTLIER — @p.ZoneName: rich (value @p.ResourcesValue.ToString("N0", CultureInfo.InvariantCulture)) with weak guards (mult @p.GuardMultiplier.ToString("F2", CultureInfo.InvariantCulture))</title>
                    </circle>
                }
            </svg>

            <p class="oe-gc-hint">
                X = effective guard multiplier per zone. Y = zone resources value.
                Red dots flag zones in the top quartile of value with bottom-quartile
                guards — the most common balance bug.
            </p>
        </details>
    }
}

@code {
    /// <summary>
    /// Last generated template, or <c>null</c> before any generation. Panel
    /// renders nothing while null — preserves the "hidden until generated"
    /// acceptance bullet.
    /// </summary>
    [Parameter] public RmgTemplate? Template { get; set; }
}
