@* T-704 — Per-player fairness audit.
   Reads Spawn-bearing zones off a generated RmgTemplate and surfaces
   neighbour count / starting-castle count / expected resource yield per
   player slot. Rows whose any metric deviates by >20% from the median are
   highlighted. Hidden until generation has produced player rows. *@

@using OldenEra.Generator.Models.Unfrozen
@using OldenEra.Generator.Services

@if (Template is not null)
{
    var report = TemplateAnalysis.ComputeFairness(Template);
    if (report.HasData)
    {
        <details class="oe-fairness" open>
            <summary class="oe-fairness-summary">
                Per-player fairness
                @if (report.AnyOutlier)
                {
                    <span class="oe-fairness-flag" title="At least one player deviates by more than the configured tolerance">
                        @CountOutliers(report) outlier@(CountOutliers(report) == 1 ? "" : "s")
                    </span>
                }
                else
                {
                    <span class="oe-fairness-clean" title="All players within tolerance of the median">
                        balanced
                    </span>
                }
            </summary>

            <div class="oe-fairness-grid" role="table" aria-label="Per-player fairness audit">
                <div class="oe-fa-head" role="row">
                    <div role="columnheader">Player</div>
                    <div role="columnheader" title="Distinct zones connected to this player's zone">Neighbours</div>
                    <div role="columnheader" title="MainObjects of type City inside the player's zone">Castles</div>
                    <div role="columnheader" title="Zone resources + guarded + unguarded value, plus bonuses targeting this slot">Yield</div>
                </div>

                @foreach (var p in report.Players)
                {
                    <div class="oe-fa-row @(p.IsOutlier ? "oe-fa-outlier" : "")" role="row">
                        <div class="oe-fa-name" role="cell">
                            P@(p.Slot)
                            <span class="oe-fa-zone">@p.ZoneName</span>
                        </div>
                        <div role="cell" class="@(p.NeighborOutlier ? "oe-fa-cell-flag" : "")">
                            @p.NeighborCount.ToString("N0")
                        </div>
                        <div role="cell" class="@(p.StartingCastleOutlier ? "oe-fa-cell-flag" : "")">
                            @p.StartingCastleCount.ToString("N0")
                        </div>
                        <div role="cell" class="@(p.ResourceYieldOutlier ? "oe-fa-cell-flag" : "")">
                            @p.ResourceYield.ToString("N0")
                        </div>
                    </div>
                }
            </div>

            <p class="oe-fa-hint">
                Median: neighbours @report.Medians.NeighborCount.ToString("0.#"),
                castles @report.Medians.StartingCastleCount.ToString("0.#"),
                yield @report.Medians.ResourceYield.ToString("N0").
                Cells flag when they deviate by more than @report.DeviationPercent.ToString("0")%
                of the median.
            </p>
        </details>
    }
}

@code {
    /// <summary>
    /// Last generated template, or <c>null</c> before any generation.
    /// Component renders nothing while null — preserves the
    /// "hidden until generated" pattern from T-701.
    /// </summary>
    [Parameter] public RmgTemplate? Template { get; set; }

    private static int CountOutliers(TemplateAnalysis.FairnessReport report)
    {
        int n = 0;
        foreach (var p in report.Players)
            if (p.IsOutlier) n++;
        return n;
    }
}
