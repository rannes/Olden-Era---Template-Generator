@* Starting bonuses applied to every player by default. Per-player override
   rows below replace the uniform value for the fields they set, on the slot
   they target. T-206. *@

<ExperimentalCard Key="starting-bonuses" Title="Starting bonuses">
    <div class="oe-hint">
        Same bonuses apply to every player. 0 / empty = no bonus.
    </div>

    <StartingBonusFields Bonuses="Settings.Bonuses" OnChanged="NotifyChanged" />

    <div class="oe-section-header" style="font-size:13px;margin-top:12px;">
        Per-player overrides
    </div>
    <div class="oe-hint">
        Override fields per slot. Fields you set replace the uniform value above
        for that slot only; unset fields inherit. Slots: 1 to @Settings.PlayerCount.
    </div>

    @for (int i = 0; i < Settings.Bonuses.PerPlayerOverrides.Count; i++)
    {
        var idx = i;
        var row = Settings.Bonuses.PerPlayerOverrides[idx];
        <div class="oe-stacked"
             style="border:1px solid var(--oe-border, #ccc); padding:8px; margin-top:8px;">
            <div style="display:flex; align-items:center; gap:8px;">
                <label class="oe-label" style="margin:0;">Player slot</label>
                <select value="@row.PlayerSlot"
                        @onchange="@(e => SetSlot(idx, e.Value?.ToString()))">
                    @for (int slot = 1; slot <= Settings.PlayerCount; slot++)
                    {
                        var s = slot;
                        <option value="@s" selected="@(s == row.PlayerSlot)">@s</option>
                    }
                </select>
                <button type="button" class="oe-btn"
                        @onclick="@(() => RemoveRow(idx))"
                        style="margin-left:auto;">Remove</button>
            </div>
            <StartingBonusFields Bonuses="row.Bonuses" OnChanged="NotifyChanged" />
        </div>
    }

    <button type="button" class="oe-btn" style="margin-top:8px;"
            @onclick="AddRow">+ Add per-player override</button>
</ExperimentalCard>

@code {
    [Parameter, EditorRequired] public GeneratorSettings Settings { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private Task NotifyChanged() => OnChanged.InvokeAsync();

    private async Task AddRow()
    {
        Settings.Bonuses.PerPlayerOverrides.Add(new PerPlayerBonusOverride
        {
            PlayerSlot = NextFreeSlot(),
            Bonuses = new StartingBonusSettings(),
        });
        await NotifyChanged();
    }

    private async Task RemoveRow(int idx)
    {
        if (idx >= 0 && idx < Settings.Bonuses.PerPlayerOverrides.Count)
        {
            Settings.Bonuses.PerPlayerOverrides.RemoveAt(idx);
            await NotifyChanged();
        }
    }

    private async Task SetSlot(int idx, string? raw)
    {
        if (idx < 0 || idx >= Settings.Bonuses.PerPlayerOverrides.Count) return;
        if (int.TryParse(raw, out var slot))
        {
            Settings.Bonuses.PerPlayerOverrides[idx].PlayerSlot = slot;
            await NotifyChanged();
        }
    }

    private int NextFreeSlot()
    {
        var used = new HashSet<int>();
        foreach (var r in Settings.Bonuses.PerPlayerOverrides) used.Add(r.PlayerSlot);
        for (int s = 1; s <= Settings.PlayerCount; s++)
            if (!used.Contains(s)) return s;
        return 1;
    }
}
