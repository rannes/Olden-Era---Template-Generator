@using OldenEra.Generator.Services
@inject PresetCatalog Catalog
@inject UserPresetStore UserPresets

@if (IsOpen)
{
    <div class="oe-modal-overlay" @onclick="Close" @onkeydown="OnKeyDown" tabindex="-1">
        <div class="oe-modal" role="dialog" aria-modal="true" aria-labelledby="preset-picker-title" @onclick:stopPropagation="true">
            <h2 id="preset-picker-title">Load preset</h2>
            <p>Pick a starting point. Your current settings will be replaced.</p>

            <h3 class="oe-preset-section">Built-in</h3>
            <ul class="oe-preset-list">
                @foreach (var entry in Catalog.Entries)
                {
                    <li>
                        <button class="oe-preset-item" @onclick="() => Pick(entry.Id)">
                            <span class="oe-preset-name">@entry.Name</span>
                            <span class="oe-preset-desc">@entry.Description</span>
                        </button>
                    </li>
                }
            </ul>

            <h3 class="oe-preset-section">My Presets</h3>
            @if (_userEntries.Count == 0)
            {
                <p class="oe-preset-empty">No saved presets yet. Use <em>Save current as preset…</em> below to add one.</p>
            }
            else
            {
                <ul class="oe-preset-list">
                    @foreach (var entry in _userEntries)
                    {
                        var name = entry.Name;
                        <li>
                            <div class="oe-preset-row">
                                <button class="oe-preset-item" @onclick="() => PickUser(name)">
                                    <span class="oe-preset-name">@name</span>
                                    <span class="oe-preset-desc">Saved by you</span>
                                </button>
                                <button class="oe-btn ghost oe-preset-delete"
                                        title="Delete this preset"
                                        @onclick="() => DeleteUser(name)">✕</button>
                            </div>
                        </li>
                    }
                </ul>
            }

            <div class="oe-preset-save">
                <input type="text" placeholder="Preset name"
                       maxlength="@UserPresetStore.MaxNameLength"
                       @bind="_newName" @bind:event="oninput" />
                <button class="oe-btn"
                        disabled="@(!CanSave())"
                        @onclick="SaveCurrent">Save current as preset</button>
                @if (!string.IsNullOrEmpty(_status))
                {
                    <span class="oe-preset-status">@_status</span>
                }
            </div>

            <div class="oe-modal-actions">
                <button class="oe-btn ghost" @onclick="Close">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    /// <summary>Built-in catalog preset picked. Argument is the preset id.</summary>
    [Parameter] public EventCallback<string> OnPick { get; set; }

    /// <summary>User preset picked. Argument is the preset name.</summary>
    [Parameter] public EventCallback<string> OnPickUser { get; set; }

    /// <summary>Provides the current settings to save when the user clicks
    /// "Save current as preset". Returning null cancels the save.</summary>
    [Parameter] public Func<OldenEra.Generator.Models.SettingsFile?>? GetCurrentSettings { get; set; }

    private List<UserPresetEntry> _userEntries = new();
    private string _newName = string.Empty;
    private string? _status;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen) await RefreshUserPresetsAsync();
    }

    private async Task RefreshUserPresetsAsync()
    {
        try
        {
            var entries = await UserPresets.ListAsync();
            _userEntries = entries.ToList();
        }
        catch
        {
            _userEntries = new List<UserPresetEntry>();
        }
    }

    private bool CanSave()
    {
        var normalized = UserPresetStore.NormalizeName(_newName);
        return !string.IsNullOrEmpty(normalized) && GetCurrentSettings is not null;
    }

    private async Task SaveCurrent()
    {
        if (GetCurrentSettings is null) return;
        var settings = GetCurrentSettings();
        if (settings is null) return;
        var name = UserPresetStore.NormalizeName(_newName);
        if (string.IsNullOrEmpty(name)) return;

        try
        {
            await UserPresets.SaveAsync(name, settings);
            _status = $"Saved '{name}'";
            _newName = string.Empty;
            await RefreshUserPresetsAsync();
        }
        catch (Exception ex)
        {
            _status = $"Save failed: {ex.Message}";
        }
    }

    private async Task DeleteUser(string name)
    {
        try
        {
            await UserPresets.DeleteAsync(name);
            _status = $"Deleted '{name}'";
            await RefreshUserPresetsAsync();
        }
        catch (Exception ex)
        {
            _status = $"Delete failed: {ex.Message}";
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        _status = null;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task Pick(string id)
    {
        await OnPick.InvokeAsync(id);
        await Close();
    }

    private async Task PickUser(string name)
    {
        await OnPickUser.InvokeAsync(name);
        await Close();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await Close();
    }
}
