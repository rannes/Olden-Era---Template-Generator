<UserControl x:Class="OldenEra.TemplateEditor.Views.ValueBudgetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!-- T-701 — Zone value budget summary. Hidden until Update(template)
         is called with a non-null RmgTemplate carrying at least one zone. -->
    <UserControl.Resources>
        <Style x:Key="VbHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource OeTextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,8,2"/>
        </Style>
        <Style x:Key="VbCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OeTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,1,8,1"/>
        </Style>
        <Style x:Key="VbCellTotal" TargetType="TextBlock" BasedOn="{StaticResource VbCell}">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Border BorderThickness="1"
            CornerRadius="6"
            BorderBrush="{StaticResource OeBorderBrush}"
            Background="{StaticResource OeSurface1Brush}"
            Padding="8,6">
        <StackPanel>
            <DockPanel LastChildFill="True">
                <TextBlock Text="Zone value budget"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource OeTextBrush}"
                           DockPanel.Dock="Left"/>
                <TextBlock x:Name="TxtTotal"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource OeTextDimBrush}"
                           FontSize="11"/>
            </DockPanel>

            <Grid x:Name="GridRows" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Rows added in code-behind so the count tracks zone count. -->
            </Grid>

            <TextBlock Margin="0,4,0,0"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource OeTextDimBrush}"
                       Text="Per-area numbers in parentheses are densities — not summed in totals. Em-dash means the field is not emitted for that zone."/>
        </StackPanel>
    </Border>
</UserControl>
