<UserControl x:Class="OldenEra.TemplateEditor.Views.ZoneContentPanel"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OldenEra.TemplateEditor.Converters">
    <UserControl.Resources>
        <!-- Grouped preset view. Source binds through to the panel-VM via
             x:Reference to the named UserControl because resources have no
             DataContext of their own. Ordinal sort is applied in code-behind
             (Loaded handler) via ListCollectionView.CustomSort so the order
             matches the Web optgroup order regardless of culture; XAML
             SortDescriptions would use the current culture's collator. -->
        <CollectionViewSource x:Key="GroupedPresets"
                              Source="{Binding DataContext.Presets, Source={x:Reference Root}}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- Style.Triggers, when added later, MUST come after all Setters
             (see CLAUDE.md -> feedback_wpf_style_child_order). BAML errors
             only surface in CI on Mac. -->
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Warning badge: orange Border + count. Style.Triggers (when added later)
             MUST come after Setters (CLAUDE.md -> feedback_wpf_style_child_order). -->
        <Style x:Key="OeWarningBadge" TargetType="Border">
            <Setter Property="Background" Value="#9A5E1C"/>
            <Setter Property="BorderBrush" Value="#6B3F10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
        <Style x:Key="OeWarningBadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1c1208"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Per-field warning badge: a small "!" pill rendered next to a
             specific input. Mirrors the Web's per-code WarningsFor badges.
             Style.Triggers (when added later) MUST come after Setters
             (CLAUDE.md -> feedback_wpf_style_child_order). -->
        <Style x:Key="OeFieldBadge" TargetType="Border">
            <Setter Property="Background" Value="#9A5E1C"/>
            <Setter Property="BorderBrush" Value="#6B3F10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
        <Style x:Key="OeFieldBadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1c1208"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>


        <DataTemplate x:Key="ZoneContentItemRowTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>  <!-- Sid -->
                    <ColumnDefinition Width="60"/>   <!-- Min -->
                    <ColumnDefinition Width="60"/>   <!-- Max -->
                    <ColumnDefinition Width="120"/>  <!-- Pool -->
                    <ColumnDefinition Width="Auto"/> <!-- Guarded -->
                    <ColumnDefinition Width="Auto"/> <!-- NearCastle -->
                    <ColumnDefinition Width="*"/>    <!-- FactionAffinity -->
                    <ColumnDefinition Width="*"/>    <!-- BiomeFilter -->
                    <ColumnDefinition Width="Auto"/> <!-- Delete (placeholder; A8 wires deletion) -->
                    <ColumnDefinition Width="Auto"/> <!-- Warning badge -->
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          Text="{Binding Sid, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding DataContext.SidCatalog, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          DisplayMemberPath="FriendlyName"
                          SelectedValuePath="Sid"
                          IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}"/>

                <TextBox Grid.Column="1"
                         Text="{Binding MinCount, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}"
                         Margin="4,0"/>
                <DockPanel Grid.Column="2" Margin="4,0" LastChildFill="True">
                    <Border DockPanel.Dock="Right" Style="{StaticResource OeFieldBadge}"
                            Visibility="{Binding HasMinMaxWarnings, Converter={StaticResource BoolToVisibility}}">
                        <Border.ToolTip>
                            <ItemsControl ItemsSource="{Binding MinMaxWarnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" Margin="0,0,0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border.ToolTip>
                        <TextBlock Style="{StaticResource OeFieldBadgeText}" Text="!"/>
                    </Border>
                    <TextBox Text="{Binding MaxCount, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}"/>
                </DockPanel>

                <DockPanel Grid.Column="3" Margin="4,0" LastChildFill="True">
                    <Border DockPanel.Dock="Right" Style="{StaticResource OeFieldBadge}"
                            Visibility="{Binding HasPoolWarnings, Converter={StaticResource BoolToVisibility}}">
                        <Border.ToolTip>
                            <ItemsControl ItemsSource="{Binding PoolWarnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" Margin="0,0,0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border.ToolTip>
                        <TextBlock Style="{StaticResource OeFieldBadgeText}" Text="!"/>
                    </Border>
                    <ComboBox ItemsSource="{Binding DataContext.PoolValues, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding Pool}"
                              IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}"/>
                </DockPanel>

                <CheckBox Grid.Column="4" Content="Guarded"
                          IsChecked="{Binding IsGuarded}"
                          IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}"
                          Margin="8,0,0,0" VerticalAlignment="Center"/>
                <CheckBox Grid.Column="5" Content="Near castle"
                          IsChecked="{Binding NearCastle}"
                          IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}"
                          Margin="8,0,0,0" VerticalAlignment="Center"/>

                <DockPanel Grid.Column="6" Margin="4,0" LastChildFill="True">
                    <Border DockPanel.Dock="Right" Style="{StaticResource OeFieldBadge}"
                            Visibility="{Binding HasFactionAffinityWarnings, Converter={StaticResource BoolToVisibility}}">
                        <Border.ToolTip>
                            <ItemsControl ItemsSource="{Binding FactionAffinityWarnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" Margin="0,0,0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border.ToolTip>
                        <TextBlock Style="{StaticResource OeFieldBadgeText}" Text="!"/>
                    </Border>
                    <TextBox Text="{Binding FactionAffinityCsv, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}"
                             ToolTip="Faction affinity (comma-separated)"/>
                </DockPanel>
                <DockPanel Grid.Column="7" Margin="4,0" LastChildFill="True">
                    <Border DockPanel.Dock="Right" Style="{StaticResource OeFieldBadge}"
                            Visibility="{Binding HasBiomeFilterWarnings, Converter={StaticResource BoolToVisibility}}">
                        <Border.ToolTip>
                            <ItemsControl ItemsSource="{Binding BiomeFilterWarnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" Margin="0,0,0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border.ToolTip>
                        <TextBlock Style="{StaticResource OeFieldBadgeText}" Text="!"/>
                    </Border>
                    <TextBox Text="{Binding BiomeFilterCsv, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}"
                             ToolTip="Biome filter (comma-separated)"/>
                </DockPanel>

                <!-- Delete button: removes the row's item-VM from its
                     owning scope. Disabled while the panel is in
                     defaults-compare (read-only) mode. -->
                <Button Grid.Column="8" Content="✕"
                        Click="DeleteRow_Click"
                        IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}"
                        Margin="4,0,0,0" Padding="6,0"/>

                <!-- Per-row warning badge. Aggregates the row's full warning
                     count; per-field badges live next to the relevant input. -->
                <Border Grid.Column="9" Style="{StaticResource OeWarningBadge}"
                        Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                    <Border.ToolTip>
                        <ItemsControl ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" Margin="0,0,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border.ToolTip>
                    <TextBlock Style="{StaticResource OeWarningBadgeText}"
                               Text="{Binding WarningCount}"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Body template shared across all scope tabs (Player + 4 neutrals + per-zone right pane).
             DataContext here is the scope-VM; Tag carries the scope-VM through to
             the SelectionChanged code-behind so AddPreset targets the right tab. -->
        <DataTemplate x:Key="ZoneContentScopeBodyTemplate">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,6">
                    <TextBlock Text="Add from preset:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Source={StaticResource GroupedPresets}}"
                              DisplayMemberPath="Name"
                              IsEnabled="{Binding DataContext.IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBool}}"
                              Tag="{Binding}"
                              SelectionChanged="PresetCombo_SelectionChanged">
                        <ComboBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Margin="2,4,0,2"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ComboBox.GroupStyle>
                    </ComboBox>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Items}"
                                  ItemTemplate="{StaticResource ZoneContentItemRowTemplate}"/>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource SectionBorder}">
        <DockPanel>
            <!-- Toolbar: defaults-compare toggle + total warning count -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <CheckBox x:Name="ChkDefaultsCompare"
                          Content="Compare against defaults (read-only)"
                          IsChecked="{Binding IsDefaultsCompareActive, Mode=TwoWay}"/>
                <TextBlock Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Text="{Binding Warnings.Count, StringFormat=Warnings: {0}}"/>
            </StackPanel>

            <TabControl>
                <TabItem DataContext="{Binding PlayerScope}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Player"/>
                            <Border Style="{StaticResource OeWarningBadge}"
                                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource OeWarningBadgeText}"
                                           Text="{Binding WarningCount}"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource ZoneContentScopeBodyTemplate}"/>
                </TabItem>
                <TabItem DataContext="{Binding NeutralGlobalScope}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Neutral · Global"/>
                            <Border Style="{StaticResource OeWarningBadge}"
                                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource OeWarningBadgeText}"
                                           Text="{Binding WarningCount}"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource ZoneContentScopeBodyTemplate}"/>
                </TabItem>
                <TabItem DataContext="{Binding PoorScope}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Neutral · Poor"/>
                            <Border Style="{StaticResource OeWarningBadge}"
                                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource OeWarningBadgeText}"
                                           Text="{Binding WarningCount}"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource ZoneContentScopeBodyTemplate}"/>
                </TabItem>
                <TabItem DataContext="{Binding NormalScope}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Neutral · Normal"/>
                            <Border Style="{StaticResource OeWarningBadge}"
                                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource OeWarningBadgeText}"
                                           Text="{Binding WarningCount}"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource ZoneContentScopeBodyTemplate}"/>
                </TabItem>
                <TabItem DataContext="{Binding RichScope}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Neutral · Rich"/>
                            <Border Style="{StaticResource OeWarningBadge}"
                                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource OeWarningBadgeText}"
                                           Text="{Binding WarningCount}"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <ContentControl Content="{Binding}"
                                    ContentTemplate="{StaticResource ZoneContentScopeBodyTemplate}"/>
                </TabItem>
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Per-zone"/>
                            <Border Style="{StaticResource OeWarningBadge}"
                                    Visibility="{Binding PerZoneHasWarnings, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource OeWarningBadgeText}"
                                           Text="{Binding PerZoneWarningCount}"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="LbPerZoneLetters"
                                 Grid.Column="0"
                                 ItemsSource="{Binding PerZoneScopesOrdered}"
                                 DisplayMemberPath="Key"
                                 SelectedValuePath="Key"
                                 SelectedIndex="0"
                                 Margin="0,0,8,0"/>
                        <ContentControl Grid.Column="1"
                                        Content="{Binding ElementName=LbPerZoneLetters, Path=SelectedItem.Value}"
                                        ContentTemplate="{StaticResource ZoneContentScopeBodyTemplate}"/>
                    </Grid>
                </TabItem>
                <TabItem Header="Road decorations">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   Text="Road decorations are read-only in this round. Edit support arrives in a future round."/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding RoadDecorations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Zone}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RoadType}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding From.Kind, StringFormat=From: {0}}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding To.Kind, StringFormat=To: {0}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</UserControl>
