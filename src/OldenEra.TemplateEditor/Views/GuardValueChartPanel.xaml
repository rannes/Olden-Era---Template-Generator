<UserControl x:Class="OldenEra.TemplateEditor.Views.GuardValueChartPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!-- T-702 — Guard-power vs. zone-value chart. Hidden until Update(template)
         is called with a non-null RmgTemplate carrying at least one zone with
         both guardMultiplier and resourcesValue emitted. -->
    <Border BorderThickness="1"
            CornerRadius="6"
            BorderBrush="{StaticResource OeBorderBrush}"
            Background="{StaticResource OeSurface1Brush}"
            Padding="8,6">
        <StackPanel>
            <DockPanel LastChildFill="True">
                <TextBlock Text="Guard vs. value"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource OeTextBrush}"
                           DockPanel.Dock="Left"/>
                <TextBlock x:Name="TxtOutliers"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource OeTextDimBrush}"
                           FontSize="11"/>
            </DockPanel>

            <Canvas x:Name="ChartCanvas"
                    Width="360" Height="220"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    Background="Transparent"/>

            <TextBlock Margin="0,4,0,0"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource OeTextDimBrush}"
                       Text="X = effective guard multiplier per zone. Y = zone resources value. Red dots flag zones in the top quartile of value with bottom-quartile guards — the most common balance bug."/>
        </StackPanel>
    </Border>
</UserControl>
