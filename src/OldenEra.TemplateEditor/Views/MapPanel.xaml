<UserControl x:Class="OldenEra.TemplateEditor.Views.MapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource SectionBorder}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="TEMPLATE" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" x:Name="LblTemplateName" Content="Template Name"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtTemplateName" Text="Custom Template"/>
                    <Label Grid.Row="2" Grid.Column="0" x:Name="LblSeed" Content="Seed"/>
                    <DockPanel Grid.Row="2" Grid.Column="1" LastChildFill="True">
                        <Button x:Name="BtnRandomizeSeed"
                                DockPanel.Dock="Right"
                                Content="&#x1F3B2;"
                                Margin="4,0,0,0"
                                Padding="6,0"
                                MinWidth="28"
                                Click="BtnRandomizeSeed_Click"
                                ToolTip="Generate a new random seed (reproducible output for the same seed)"/>
                        <TextBox x:Name="TxtSeed"
                                 ToolTip="Optional integer seed. Leave blank for non-deterministic generation."/>
                    </DockPanel>
                    <TextBlock Grid.Row="4" Grid.Column="1"
                               x:Name="TxtSeedUsed"
                               Foreground="{StaticResource OeTextDimBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text=""/>
                    <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                               Foreground="{StaticResource OeTextDimBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="Seeds the random choices this generator makes when building the template (zone topology, neutral placement, content rolls). The same seed with the same settings always produces an identical template file — useful for sharing or reproducing a template. Leave blank for a fresh template each time, or click &#x1F3B2; to pick a seed. Note: in-game map layout is rolled separately by Olden Era when a match starts, so the same template can still play differently."/>
                    <Label Grid.Row="8" Grid.Column="0" x:Name="LblMapSize" Content="Map Size"/>
                    <ComboBox x:Name="CmbMapSize" Grid.Row="8" Grid.Column="1"/>
                    <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2">
                        <CheckBox x:Name="ChkExperimentalMapSizes"
                                  Content="Experimental large map sizes"
                                  Margin="0,6,0,0"
                                  Visibility="Visible"/>
                        <TextBlock x:Name="TxtExperimentalMapSizeWarning"
                                   Foreground="{StaticResource OeTextDimBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   Visibility="Collapsed"
                                   Text="Adds 256x256 through 512x512. Official templates top out at 240x240, so larger maps may fail, freeze, or behave unpredictably in game."/>
                    </StackPanel>
                    <DockPanel Grid.Row="12" Grid.Column="0">
                        <Label x:Name="LblPlayers" Content="Players" DockPanel.Dock="Left"/>
                        <TextBlock x:Name="TxtPlayers" Text="2" DockPanel.Dock="Right"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,4,0" Style="{StaticResource ValueText}"/>
                    </DockPanel>
                    <Slider Grid.Row="12" Grid.Column="1" x:Name="SldPlayers"
                            Minimum="2" Maximum="8" Value="2"
                            TickFrequency="1" IsSnapToTickEnabled="True"/>
                    <Label Grid.Row="14" Grid.Column="0" Content="Description"
                           VerticalAlignment="Top"/>
                    <TextBox Grid.Row="14" Grid.Column="1" x:Name="TxtTemplateDescription"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="60"
                             ToolTip="Optional override for the auto-generated description. Leave blank for the generator default."/>
                    <TextBlock Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="2"
                               Foreground="{StaticResource OeTextDimBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="Overrides the auto-generated description field. Empty falls back to the generator's summary (topology, zone counts, etc.)."/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
