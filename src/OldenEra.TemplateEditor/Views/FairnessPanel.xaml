<UserControl x:Class="OldenEra.TemplateEditor.Views.FairnessPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!-- T-704 — Per-player fairness audit. Hidden until Update(template) is
         called with a template that has at least one Spawn-bearing zone.
         WPF parity for OldenEra.Web.Components.FairnessPanel. -->
    <UserControl.Resources>
        <Style x:Key="FaHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource OeTextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,8,2"/>
        </Style>
        <Style x:Key="FaCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OeTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,1,8,1"/>
        </Style>
        <Style x:Key="FaCellFlag" TargetType="TextBlock" BasedOn="{StaticResource FaCell}">
            <Setter Property="Foreground" Value="{StaticResource OeErrorBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Border BorderThickness="1"
            CornerRadius="6"
            BorderBrush="{StaticResource OeBorderBrush}"
            Background="{StaticResource OeSurface1Brush}"
            Padding="8,6">
        <StackPanel>
            <DockPanel LastChildFill="True">
                <TextBlock Text="Per-player fairness"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource OeTextBrush}"
                           DockPanel.Dock="Left"/>
                <TextBlock x:Name="TxtStatus"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource OeTextDimBrush}"
                           FontSize="11"/>
            </DockPanel>

            <Grid x:Name="GridRows" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Rows added in code-behind so the count tracks player count. -->
            </Grid>

            <TextBlock x:Name="TxtHint"
                       Margin="0,4,0,0"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource OeTextDimBrush}"/>
        </StackPanel>
    </Border>
</UserControl>
