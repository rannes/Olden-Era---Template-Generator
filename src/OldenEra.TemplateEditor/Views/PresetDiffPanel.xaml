<UserControl x:Class="OldenEra.TemplateEditor.Views.PresetDiffPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!-- T-805 — settings-vs-preset diff. WPF parity for
         OldenEra.Web.Components.PresetDiffPanel. Hidden until ShowFor() is
         called with a preset snapshot. -->
    <UserControl.Resources>
        <Style x:Key="PdHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource OeTextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,8,2"/>
        </Style>
        <Style x:Key="PdField" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OeTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Consolas, Menlo, monospace"/>
            <Setter Property="Margin" Value="0,1,8,1"/>
        </Style>
        <Style x:Key="PdValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OeTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,1,8,1"/>
        </Style>
    </UserControl.Resources>

    <Border BorderThickness="1"
            CornerRadius="6"
            BorderBrush="{StaticResource OeBorderBrush}"
            Background="{StaticResource OeSurface1Brush}"
            Padding="8,6">
        <StackPanel>
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="TxtTitle"
                           Text="Compared to preset"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource OeTextBrush}"
                           DockPanel.Dock="Left"/>
                <TextBlock x:Name="TxtCount"
                           DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource OeTextDimBrush}"
                           FontSize="11"/>
            </DockPanel>

            <TextBlock x:Name="TxtEmpty"
                       Margin="0,4,0,0"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource OeTextDimBrush}"
                       Visibility="Collapsed"
                       Text="No top-level fields differ from the loaded preset."/>

            <Grid x:Name="GridRows" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Rows added in code-behind. -->
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
