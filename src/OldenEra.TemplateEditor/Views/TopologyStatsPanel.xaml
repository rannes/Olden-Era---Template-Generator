<UserControl x:Class="OldenEra.TemplateEditor.Views.TopologyStatsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <!-- T-705 — Topology graph stats. Hidden until Update(template) is
         called with a non-null RmgTemplate carrying at least one variant. -->
    <UserControl.Resources>
        <Style x:Key="TgLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OeTextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,1,8,1"/>
        </Style>
        <Style x:Key="TgValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OeTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TgVariantHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OeTextDimBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
    </UserControl.Resources>

    <Border BorderThickness="1"
            CornerRadius="6"
            BorderBrush="{StaticResource OeBorderBrush}"
            Background="{StaticResource OeSurface1Brush}"
            Padding="8,6">
        <StackPanel>
            <TextBlock Text="Topology graph stats"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource OeTextBrush}"/>

            <StackPanel x:Name="PnlVariants" Margin="0,4,0,0"/>

            <TextBlock Margin="0,4,0,0"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource OeTextDimBrush}"
                       Text="Edges are undirected; parallel connections and self-loops are deduped. Diameter is computed over the largest connected component."/>
        </StackPanel>
    </Border>
</UserControl>
