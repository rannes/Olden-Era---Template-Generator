<Window x:Class="OldenEra.TemplateEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:OldenEra.TemplateEditor.Views"
        mc:Ignorable="d"
        Title="Olden Era - Simple Template Generator"
        Height="800" Width="1050"
        MinHeight="800" MinWidth="1050"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Background="{StaticResource OeBgBrush}"
        Foreground="{StaticResource OeTextBrush}"
        FontFamily="{StaticResource OeFont}"
        FontSize="13">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl"       Command="{x:Static ApplicationCommands.New}"/>
        <KeyBinding Key="O" Modifiers="Ctrl"       Command="{x:Static ApplicationCommands.Open}"/>
        <KeyBinding Key="S" Modifiers="Ctrl"       Command="{x:Static ApplicationCommands.Save}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{x:Static ApplicationCommands.SaveAs}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.New}"    Executed="BtnNew_Click"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Open}"   Executed="BtnOpen_Click"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Save}"   Executed="BtnSave_Click"/>
        <CommandBinding Command="{x:Static ApplicationCommands.SaveAs}" Executed="BtnSaveAs_Click"/>
    </Window.CommandBindings>

    <!-- Hidden combo boxes required by code-behind -->
    <Window.Resources>
        <Style x:Key="RowSpacer" TargetType="RowDefinition">
            <Setter Property="Height" Value="8"/>
        </Style>
    </Window.Resources>

    <!-- Outer border gives the window its themed frame. -->
    <Border BorderBrush="{StaticResource OeBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>    <!-- custom title bar -->
                <RowDefinition Height="*"/>     <!-- page content -->
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Grid Grid.Row="0" Background="{StaticResource OeSurface1Brush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Image Source="pack://application:,,,/favicon.ico" Width="16" Height="16"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="TxtWindowTitle"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource OeTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window-state buttons only. Action toolbar lives below the title bar. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Button Content="—" Style="{StaticResource TitleBarButton}" ToolTip="Minimize" Click="BtnMinimize_Click"/>
                    <Button x:Name="BtnMaximize" Content="▢" Style="{StaticResource TitleBarButton}" ToolTip="Maximize" Click="BtnMaximize_Click"/>
                    <Button Content="✕" Style="{StaticResource TitleBarCloseButton}" ToolTip="Close" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- Page content: toolbar row | WIP banner | three-column shell. -->
            <Grid Grid.Row="1" Margin="20,12,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- toolbar -->
                    <RowDefinition Height="Auto"/>  <!-- WIP warning -->
                    <RowDefinition Height="Auto"/>  <!-- spacer -->
                    <RowDefinition Height="*"/>     <!-- shell -->
                </Grid.RowDefinitions>

                <!-- Action toolbar: settings file ops, links, master toggles. -->
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="New" Click="BtnNew_Click" Style="{StaticResource OeGhostButton}" ToolTip="Reset settings (Ctrl+N)"/>
                        <Button Content="Open…" Click="BtnOpen_Click" Style="{StaticResource OeGhostButton}" ToolTip="Open settings (Ctrl+O)"/>
                        <Button Content="Save" Click="BtnSave_Click" Style="{StaticResource OeGhostButton}" ToolTip="Save settings (Ctrl+S)"/>
                        <Button Content="Save as…" Click="BtnSaveAs_Click" Style="{StaticResource OeGhostButton}" ToolTip="Save settings as (Ctrl+Shift+S)"/>
                        <Button x:Name="BtnLoadPreset" Content="Load preset…" Click="BtnLoadPreset_Click" Style="{StaticResource OeGhostButton}" ToolTip="Load a built-in template preset"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <CheckBox x:Name="ChkAdvancedEnabled"
                                  Content="Advanced"
                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                  ToolTip="Show advanced zone settings (per-tier zone counts, separation tuning)."
                                  Checked="ChkAdvancedEnabled_Changed"
                                  Unchecked="ChkAdvancedEnabled_Changed"/>
                        <!-- T-302: per-feature experimental flags. The master
                             Experimental checkbox is now a popup button that
                             opens a panel of per-feature toggles. Nav
                             visibility is driven directly from the per-feature
                             flags inside UpdateExperimentalFeatureVisibility. -->
                        <ToggleButton x:Name="BtnExperimentalMenu"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      Padding="8,4"
                                      ToolTip="Toggle individual experimental features. Generated templates may behave unpredictably.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Experimental ⚗" VerticalAlignment="Center"/>
                                <Border x:Name="ExpFeatureCountBadge"
                                        Background="#4c8ad9"
                                        CornerRadius="9"
                                        Padding="6,0"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="TxtExpFeatureCount"
                                               Text="0"
                                               Foreground="#0c1828"
                                               FontWeight="Bold"
                                               FontSize="11"/>
                                </Border>
                                <TextBlock Text="▾" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <Popup x:Name="PopExperimentalMenu"
                               PlacementTarget="{Binding ElementName=BtnExperimentalMenu}"
                               Placement="Bottom"
                               StaysOpen="False"
                               IsOpen="{Binding IsChecked, ElementName=BtnExperimentalMenu, Mode=TwoWay}"
                               AllowsTransparency="True">
                            <Border Background="{StaticResource OeSurfaceBrush}"
                                    BorderBrush="{StaticResource OeBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6"
                                    MinWidth="320">
                                <StackPanel>
                                    <TextBlock Text="EXPERIMENTAL FEATURES"
                                               Foreground="{StaticResource OeTextDimBrush}"
                                               FontWeight="Bold" FontSize="11"
                                               Margin="6,4,6,2"/>
                                    <TextBlock Foreground="{StaticResource OeTextDimBrush}"
                                               FontSize="11" TextWrapping="Wrap"
                                               Margin="6,0,6,6">
                                        Each flag enables one section group. Disabled
                                        groups stay hidden; their settings remain in memory.
                                    </TextBlock>
                                    <CheckBox x:Name="ChkExpFeatureGameMode"
                                              Margin="6,4"
                                              Checked="ExpFeatureFlag_Changed"
                                              Unchecked="ExpFeatureFlag_Changed">
                                        <StackPanel>
                                            <TextBlock Text="Game mode" FontWeight="SemiBold"/>
                                            <TextBlock Text="Single-hero / hire-ban / desertion overrides."
                                                       Foreground="{StaticResource OeTextDimBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="ChkExpFeatureStartingBonuses"
                                              Margin="6,4"
                                              Checked="ExpFeatureFlag_Changed"
                                              Unchecked="ExpFeatureFlag_Changed">
                                        <StackPanel>
                                            <TextBlock Text="Starting bonuses" FontWeight="SemiBold"/>
                                            <TextBlock Text="Resources, hero stats, items, spells, unit multipliers."
                                                       Foreground="{StaticResource OeTextDimBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="ChkExpFeatureZoneContent"
                                              Margin="6,4"
                                              Checked="ExpFeatureFlag_Changed"
                                              Unchecked="ExpFeatureFlag_Changed">
                                        <StackPanel>
                                            <TextBlock Text="Zone content" FontWeight="SemiBold"/>
                                            <TextBlock Text="Per-zone biome / pool / cutoff / encounter-hole overrides."
                                                       Foreground="{StaticResource OeTextDimBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="ChkExpFeatureBordersRoads"
                                              Margin="6,4"
                                              Checked="ExpFeatureFlag_Changed"
                                              Unchecked="ExpFeatureFlag_Changed">
                                        <StackPanel>
                                            <TextBlock Text="Map borders &amp; roads" FontWeight="SemiBold"/>
                                            <TextBlock Text="Border corner radius, water border, road type."
                                                       Foreground="{StaticResource OeTextDimBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="ChkExpFeaturePerTierOverrides"
                                              Margin="6,4"
                                              Checked="ExpFeatureFlag_Changed"
                                              Unchecked="ExpFeatureFlag_Changed">
                                        <StackPanel>
                                            <TextBlock Text="Per-tier overrides" FontWeight="SemiBold"/>
                                            <TextBlock Text="Building presets / guard progression per neutral tier."
                                                       Foreground="{StaticResource OeTextDimBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <CheckBox x:Name="ChkCheckForUpdates"
                                  Content="Check for updates on startup"
                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                  ToolTip="When enabled, the app checks GitHub for a new release at startup."
                                  Checked="ChkCheckForUpdates_Changed"
                                  Unchecked="ChkCheckForUpdates_Changed"/>
                        <Button Content="GitHub" Click="BtnGithub_Click" Style="{StaticResource OeGhostButton}" ToolTip="View the project on GitHub"/>
                        <Button Content="Patch Notes" Click="BtnPatchNotes_Click" Style="{StaticResource OeGhostButton}" ToolTip="View release notes on GitHub"/>
                        <Button Content="Discord" Click="BtnDiscord_Click" Style="{StaticResource OeGhostButton}" ToolTip="Join the community Discord"/>
                    </StackPanel>
                </DockPanel>

                <!-- WIP warning: amber left bar, surface bg, no decorative border. -->
                <Border Grid.Row="1"
                        Background="{StaticResource OeWarnBgBrush}"
                        BorderBrush="{StaticResource OeAccentBrush}"
                        BorderThickness="3,0,0,0"
                        Padding="14,10"
                        Margin="0,0,0,16">
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="TxtWipWarning"
                                   Foreground="{StaticResource OeTextBrush}"
                                   FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Foreground="{StaticResource OeTextDimBrush}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">
                            Prefer the browser?
                            <Hyperlink x:Name="LinkWebVersion"
                                       NavigateUri="https://rannes.github.io/olden-era-templates/"
                                       Foreground="{StaticResource OeAccentBrush}"
                                       RequestNavigate="LinkWebVersion_RequestNavigate">Try the web version</Hyperlink>.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Three-column shell: nav | content | preview -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- Section nav: ListBox driving which panel is visible. -->
                    <ListBox Grid.Column="0"
                             x:Name="LstNav"
                             Background="Transparent"
                             BorderThickness="0"
                             Focusable="True"
                             KeyboardNavigation.TabNavigation="Once"
                             SelectionChanged="LstNav_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource OeTextDimBrush}"/>
                                <Setter Property="FontFamily" Value="{StaticResource OeFont}"/>
                                <Setter Property="FontSize"   Value="13"/>
                                <Setter Property="Padding"    Value="12,8"/>
                                <Setter Property="Margin"     Value="0,1"/>
                                <Setter Property="Cursor"     Value="Hand"/>
                                <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                <Setter Property="BorderBrush"     Value="Transparent"/>
                                <Setter Property="Background"      Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource OeSurface2Brush}"/>
                                                    <Setter Property="Foreground"                  Value="{StaticResource OeTextBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"  Value="{StaticResource OeSurface2Brush}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource OeAccentBrush}"/>
                                                    <Setter Property="Foreground"                  Value="{StaticResource OeTextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBoxItem Content="Map"            Tag="Map"     IsSelected="True"/>
                        <ListBoxItem Content="Heroes"         Tag="Heroes"/>
                        <ListBoxItem Content="Topology"       Tag="Topology"/>
                        <ListBoxItem Content="Zones"          Tag="Zones"/>
                        <ListBoxItem Content="Zone content"   Tag="ZoneContent"/>
                        <ListBoxItem Content="Win Conditions" Tag="WinConditions"/>
                        <ListBoxItem x:Name="LstNavExperimental" Content="Experimental ⚗" Tag="Experimental" Visibility="Collapsed"/>
                    </ListBox>

                    <!-- Content column: each panel always exists for code-behind compatibility,
                         but only one is Visible at a time. LstNav_SelectionChanged toggles them. -->
                    <Grid Grid.Column="2">
                        <views:MapPanel             x:Name="PnlMap"        Visibility="Visible"/>
                        <views:HeroesPanel          x:Name="PnlHeroes"     Visibility="Collapsed"/>
                        <views:TopologyPanel        x:Name="PnlTopology"   Visibility="Collapsed"/>
                        <views:ZonesPanel           x:Name="PnlZones"      Visibility="Collapsed"/>
                        <views:ZoneContentPanel     x:Name="PnlZoneContent" Visibility="Collapsed"/>
                        <views:WinConditionsPanel   x:Name="PnlGameRules"  Visibility="Collapsed"/>
                        <views:ExperimentalPanel    x:Name="PnlExperimental" Visibility="Collapsed"/>
                    </Grid>

                    <!-- Preview column. -->
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>   <!-- generate button -->
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>   <!-- validation -->
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>      <!-- image -->
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>   <!-- outdated warning -->
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>   <!-- show preview checkbox -->
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>   <!-- save button -->
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>   <!-- T-701 value budget -->
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>   <!-- T-702 guard chart -->
                        </Grid.RowDefinitions>

                        <Button Grid.Row="0"
                                x:Name="BtnPreview"
                                Content="Generate Template"
                                Style="{StaticResource GenerateButton}"
                                HorizontalAlignment="Stretch"
                                Click="BtnPreview_Click"/>

                        <StackPanel Grid.Row="2" x:Name="PnlValidation">
                            <TextBlock x:Name="TxtValidation"
                                       Foreground="{StaticResource OeErrorBrush}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Stretch" TextAlignment="Center"/>
                            <!-- Inline fix-action buttons (T-303). Visible only when the
                                 corresponding mechanical fix would resolve the active blocker. -->
                            <StackPanel x:Name="PnlValidationFixes"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,4,0,0"
                                        Visibility="Collapsed">
                                <Button x:Name="BtnFixAddNeutralZone"
                                        Content="Add a neutral zone"
                                        Margin="0,0,6,0"
                                        Padding="8,2"
                                        Visibility="Collapsed"
                                        Click="BtnFixAddNeutralZone_Click"/>
                                <Button x:Name="BtnFixSwitchToHub"
                                        Content="Switch to Hub layout"
                                        Margin="0,0,6,0"
                                        Padding="8,2"
                                        Visibility="Collapsed"
                                        Click="BtnFixSwitchToHub_Click"/>
                                <Button x:Name="BtnFixTemplateName"
                                        Content="Use &quot;Custom Template&quot;"
                                        Padding="8,2"
                                        Visibility="Collapsed"
                                        Click="BtnFixTemplateName_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="4"
                                BorderThickness="1"
                                CornerRadius="6"
                                BorderBrush="{StaticResource OeBorderBrush}"
                                Background="{StaticResource OeSurface1Brush}"
                                Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Zoom + reseed toolbar. Hidden until a preview is rendered. -->
                                <DockPanel Grid.Row="0"
                                           x:Name="PnlPreviewToolbar"
                                           LastChildFill="True"
                                           Visibility="Collapsed">
                                    <Button x:Name="BtnZoomOut"
                                            DockPanel.Dock="Left"
                                            Content="−"
                                            Width="24" Height="24"
                                            ToolTip="Zoom out"
                                            Click="BtnZoomOut_Click"/>
                                    <Button x:Name="BtnZoomIn"
                                            DockPanel.Dock="Left"
                                            Content="+"
                                            Width="24" Height="24"
                                            Margin="4,0,0,0"
                                            ToolTip="Zoom in"
                                            Click="BtnZoomIn_Click"/>
                                    <TextBlock x:Name="TxtZoomLabel"
                                               DockPanel.Dock="Right"
                                               VerticalAlignment="Center"
                                               MinWidth="44"
                                               TextAlignment="Right"
                                               Foreground="{StaticResource OeTextDimBrush}"
                                               Text="100%"/>
                                    <Button x:Name="BtnZoomReset"
                                            DockPanel.Dock="Right"
                                            Content="Reset"
                                            Margin="4,0,4,0"
                                            ToolTip="Reset zoom to 100%"
                                            Click="BtnZoomReset_Click"/>
                                    <Button x:Name="BtnReseed"
                                            DockPanel.Dock="Right"
                                            Content="🎲 Reseed"
                                            Margin="0,0,4,0"
                                            ToolTip="Pick a new random seed and regenerate"
                                            Click="BtnReseed_Click"/>
                                    <Slider x:Name="SldZoom"
                                            Minimum="50" Maximum="300"
                                            TickFrequency="25"
                                            IsSnapToTickEnabled="True"
                                            Value="100"
                                            VerticalAlignment="Center"
                                            Margin="6,0,6,0"
                                            ValueChanged="SldZoom_ValueChanged"/>
                                </DockPanel>

                                <Label Grid.Row="2"
                                       x:Name="LblNoPreview"
                                       Visibility="Collapsed"
                                       FontSize="172"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource OeTextDimBrush}"/>

                                <ScrollViewer Grid.Row="2"
                                              x:Name="ScrollPreview"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              Background="Transparent">
                                    <Image x:Name="ImgPreview"
                                           Stretch="None"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top">
                                        <Image.LayoutTransform>
                                            <ScaleTransform x:Name="ImgPreviewScale" ScaleX="1" ScaleY="1"/>
                                        </Image.LayoutTransform>
                                    </Image>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="6"
                                   x:Name="TxtOutdatedWarning"
                                   Foreground="{StaticResource OeErrorBrush}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Visibility="Hidden"
                                   HorizontalAlignment="Stretch" TextAlignment="Center"
                                   Text="Settings changed — regenerate before saving."/>

                        <CheckBox Grid.Row="8"
                                  x:Name="ChkSavePreviewImage"
                                  Content="Show preview"
                                  IsChecked="True"
                                  HorizontalAlignment="Left"
                                  Click="ChkSavePreviewImage_Click"/>

                        <Button Grid.Row="10"
                                x:Name="BtnSaveGenerated"
                                Content="Save Template"
                                Style="{StaticResource GenerateButton}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="False"
                                Click="BtnSaveGenerated_Click"/>

                        <views:ValueBudgetPanel Grid.Row="12"
                                                x:Name="PnlValueBudget"/>

                        <views:GuardValueChartPanel Grid.Row="14"
                                                    x:Name="PnlGuardChart"/>
                    </Grid>
                </Grid>

                <!-- Hidden combos still required by code-behind. -->
                <ComboBox x:Name="CmbGameMode" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtAppTitle" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
